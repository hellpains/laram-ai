# Скопируйте в .env и заполните. Без ключей Yandex сервис работает в демо-режиме.

# --- Yandex Cloud / AI Studio ---
# Сервисный аккаунт с ролями ai.speechkit-stt.user и ai.languageModels.user, API-ключ этого аккаунта
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель распознавания: general (быстро) или deferred-general (дешевле, результат до суток)
YANDEX_STT_MODEL=general
# Языки распознавания через запятую
YANDEX_STT_LANGUAGES=ru-RU
YANDEX_GPT_MODEL=yandexgpt/latest

# --- Модель распознавания речи ---
# yandex — Yandex SpeechKit (облако); gigaam — GigaAM-v3 от Сбера, работает локально, бесплатно, записи никуда не уходят.
# Пусто = yandex при наличии ключей. Конспект в любом случае делает YandexGPT.
STT_PROVIDER=
# 1 — собрать сервис с GigaAM (нужно для STT_PROVIDER=gigaam). После изменения: stop.bat, затем start.bat
WITH_GIGAAM=0
GIGAAM_MODEL=v3_e2e_rnnt

# --- Битрикс24 ---
# Входящий вебхук с правами crm, task, telephony, disk: https://ваш-портал.bitrix24.ru/rest/1/xxxxxxxx/
BITRIX_WEBHOOK_URL=
# Коды полей сделки (создаются скриптом scripts/setup_bitrix.py)
BITRIX_FIELD_RESULT=UF_CRM_CALL_RESULT
BITRIX_FIELD_AGREEMENTS=UF_CRM_CALL_AGREEMENTS
BITRIX_FIELD_NEXT_STEP=UF_CRM_CALL_NEXT_STEP
BITRIX_FIELD_NEXT_DATE=UF_CRM_CALL_NEXT_DATE
# Ставить ответственному задачу на следующий шаг
BITRIX_CREATE_TASK=true
# Во сколько ставить дедлайн задачи в день следующего шага
BITRIX_TASK_HOUR=12

# --- Автоматический приём звонков из Битрикс24 ---
# Токен исходящего вебхука (событие ONVOXIMPLANTCALLEND), из его настроек в Битрикс24
BITRIX_APP_TOKEN=
# Звонки короче этого (секунды) не обрабатываем: автоответчики, «перезвоните позже»
MIN_CALL_SECONDS=20
# Сколько минут ждать, пока АТС прикрепит запись к звонку
RECORD_WAIT_MINUTES=15
# Как часто проверять, появилась ли запись (секунды)
RECORD_POLL_SECONDS=30

# --- Сервис ---
# Домен для HTTPS (только для запуска через docker compose)
DOMAIN=
# Пароль на веб-интерфейс (логин любой). Обязательно задайте на сервере.
APP_PASSWORD=
# Секрет для вебхука телефонии: POST /webhooks/call?secret=...
WEBHOOK_SECRET=
TIMEZONE=Europe/Moscow
# Сколько звонков обрабатывать одновременно
WORKERS=2
